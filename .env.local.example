# Built-in Next.js API: no separate backend URL is needed.
# Development can use temporary MongoDB when this variable is absent.
# For persistent data, securely add MONGODB_URI in .env.local / Vercel settings.
# Generate a private signing secret: openssl rand -hex 32
# JWT_SECRET is required for production accounts.

# Optional: proxy to a separately deployed backend instead of the built-in API.
# API_SERVER_URL=https://your-backend.onrender.com
# Optional direct browser access (requires matching backend CORS_ORIGIN):
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
